local function notify(title, text, dur, force)
    if not notifOn and not force then return end
    local slot = new("Frame", {Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Parent = notifHolder})
    local card = new("Frame", {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(1.2, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = slot})
    corner(card, 12); stroke(card, 1.8, true)
    new("UIGradient", {Color = GRAD_IDLE, Parent = card})
    new("TextLabel", {Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(12, 5), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = RED, TextXAlignment = Enum.TextXAlignment.Left, Text = "🐱 " .. title, Parent = card})
    new("TextLabel", {Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(12, 29), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = text, Parent = card})
    tw(card, .35, {Position = UDim2.new()}, Enum.EasingStyle.Back)
    task.delay(dur or 2.5, function()
        if not card.Parent then return end
        tw(card, .3, {Position = UDim2.new(1.2, 0, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.wait(.35); slot:Destroy()
    end)
end

