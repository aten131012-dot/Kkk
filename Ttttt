-- แกนหลัก
local FLAGS = {alert = false, summary = true, saveOn = true, statshud = false, mark = false, markdist = false, arrow = false}
-- ชื่อ attribute ที่ใช้ตรวจว่าเพื่อนล้ม (ถ้าเกมใช้ชื่ออื่น ให้เพิ่มที่นี่)
local DOWNED_ATTRS = {"Downed", "downed", "Knocked", "KnockedOut", "IsDowned", "Incapacitated"}

local function isDowned(plr)
    local ch = plr.Character
    if not ch then return false end
    for _, a in ipairs(DOWNED_ATTRS) do
        if ch:GetAttribute(a) == true or plr:GetAttribute(a) == true then return true end
    end
    return false
end
local function myRoot() local c = lp.Character; return c and c:FindFirstChild("HumanoidRootPart") end

-- ตรวจจับโรบอท: Model ที่มี Humanoid ที่ไม่ใช่ผู้เล่น หรือชื่อมีคำว่า "bot"
local bots = {}
local function tryAddBot(inst)
    local mdl
    if inst:IsA("Humanoid") then
        mdl = inst.Parent
    elseif inst:IsA("Model") and inst.Name:lower():find("bot", 1, true) then
        mdl = inst
    end
    if mdl and mdl:IsA("Model") and not Players:GetPlayerFromCharacter(mdl) then
        local r = mdl:FindFirstChild("HumanoidRootPart") or mdl.PrimaryPart or mdl:FindFirstChildWhichIsA("BasePart")
        if r then bots[mdl] = r end
    end
end
for _, d in ipairs(workspace:GetDescendants()) do tryAddBot(d) end
connect(workspace.DescendantAdded, tryAddBot)
connect(workspace.DescendantRemoving, function(i) if bots[i] then bots[i] = nil end end)

local function nearestBot(pos)
    local best, bp
    for mdl, r in pairs(bots) do
        if mdl.Parent and r.Parent and not Players:GetPlayerFromCharacter(mdl) then
            local d = (r.Position - pos).Magnitude
            if not best or d < best then best, bp = d, r.Position end
        else
            bots[mdl] = nil
        end
    end
    return best, bp
end

