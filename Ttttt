local RADAR = {on = false, range = 120, bots = true}
local radarSetters = {}
local radarF, setRadarAll

do
    -- ---------- เรดาร์บนจอ (มุมซ้ายล่าง) ----------
    radarF = new("Frame", {Size = UDim2.fromOffset(200, 200), Position = UDim2.new(0, 18, 1, -230), BackgroundColor3 = Color3.fromRGB(12, 12, 16), BackgroundTransparency = .25, Visible = false, ZIndex = 30, Parent = gui})
    corner(radarF, 999); stroke(radarF, 2.4, true)
    local ring2 = new("Frame", {Size = UDim2.fromScale(.5, .5), AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundTransparency = 1, ZIndex = 30, Parent = radarF})
    corner(ring2, 999); new("UIStroke", {Color = RED, Thickness = 1, Transparency = .6, Parent = ring2})
    local me = new("Frame", {Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundColor3 = TEXT, ZIndex = 32, Parent = radarF})
    corner(me, 999)
    new("TextLabel", {Size = UDim2.fromOffset(20, 16), AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 2), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = RED, Text = "N", ZIndex = 32, Parent = radarF})

    local dots = {}
    local function plot(key, pos, color, used, fwd, right, m)
        local rel = pos - m.Position
        local x, z = rel:Dot(right), rel:Dot(fwd)
        local a = RADAR.range
        local px, py = x / a, -z / a
        local mag = math.sqrt(px * px + py * py)
        if mag > 1 then px, py = px / mag, py / mag end
        local f = dots[key]
        if not f then
            f = new("Frame", {Size = UDim2.fromOffset(9, 9), AnchorPoint = Vector2.new(.5, .5), ZIndex = 31, Parent = radarF})
            corner(f, 999)
            dots[key] = f
        end
        f.BackgroundColor3 = color
        f.Position = UDim2.fromScale(.5 + px * .47, .5 + py * .47)
        f.Visible = true
        used[key] = true
    end
    local function radarStep()
        local m = myRoot()
        local cam = workspace.CurrentCamera
        if not RADAR.on or not m or not cam then radarF.Visible = false; return end
        radarF.Visible = true
        local lv = cam.CFrame.LookVector
        local rv = cam.CFrame.RightVector
        local fwd = Vector3.new(lv.X, 0, lv.Z)
        local right = Vector3.new(rv.X, 0, rv.Z)
        if fwd.Magnitude < 0.01 or right.Magnitude < 0.01 then return end
        fwd, right = fwd.Unit, right.Unit
        local used = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    plot(p, r.Position, isDowned(p) and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(60, 255, 120), used, fwd, right, m)
                end
            end
        end
        if RADAR.bots then
            for mdl, r in pairs(bots) do
                if mdl.Parent and r.Parent then plot(mdl, r.Position, RED, used, fwd, right, m) end
            end
        end
        for k, f in pairs(dots) do
            if not used[k] then f.Visible = false end
        end
    end
    task.spawn(function()
        while gui.Parent do
            pcall(radarStep)
            task.wait(0.1)
        end
    end)

    setRadarAll = function(v)
        RADAR.on = v
        for _, s in ipairs(radarSetters) do s(v) end
    end

    -- ---------- ลูกศรชี้ไปหาเพื่อนที่ล้ม ----------
    local arrowF = new("Frame", {Size = UDim2.fromOffset(120, 100), AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 90), BackgroundTransparency = 1, Visible = false, ZIndex = 35, Parent = gui})
    local arrowL = new("TextLabel", {Size = UDim2.fromOffset(60, 60), AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .4), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 54, TextColor3 = RED, TextStrokeTransparency = .4, Text = "▲", ZIndex = 35, Parent = arrowF})
    local arrowT = new("TextLabel", {Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -24), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = TEXT, TextStrokeTransparency = .4, Text = "", ZIndex = 35, Parent = arrowF})
    connect(RunService.RenderStepped, function()
        local first = nearestDowned()
        local cam = workspace.CurrentCamera
        local m = myRoot()
        if not FLAGS.arrow or not first or not cam or not m or not first.root.Parent then arrowF.Visible = false; return end
        arrowF.Visible = true
        local dir = first.root.Position - cam.CFrame.Position
        local x, z = dir:Dot(cam.CFrame.RightVector), dir:Dot(cam.CFrame.LookVector)
        arrowL.Rotation = math.deg(math.atan2(x, z))
        arrowT.Text = first.plr.DisplayName .. "  " .. math.floor((m.Position - first.root.Position).Magnitude) .. " m"
    end)

    -- ---------- เครื่องหมายเพื่อนที่ล้ม ----------
    local marks = {}
    task.spawn(function()
        while gui.Parent do
            pcall(function()
                local m = myRoot()
                local seen = {}
                if FLAGS.mark then
                    for _, e in ipairs(WS.downed) do
                        local o = marks[e.plr]
                        if not o or not o.Parent then
                            o = new("BillboardGui", {Adornee = e.root, AlwaysOnTop = true, Size = UDim2.fromOffset(240, 46), StudsOffset = Vector3.new(0, 5, 0), ResetOnSpawn = false, Parent = gui})
                            new("TextLabel", {Name = "T", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 18, TextColor3 = Color3.fromRGB(255, 200, 0), TextStrokeTransparency = .2, Text = "", Parent = o})
                            marks[e.plr] = o
                        end
                        o.Adornee = e.root
                        local txt = "⚠ " .. e.plr.DisplayName
                        if FLAGS.markdist and m then txt = txt .. "  " .. math.floor(e.dist) .. " m" end
                        o.T.Text = txt
                        seen[e.plr] = true
                    end
                end
                for p, o in pairs(marks) do
                    if not seen[p] then o:Destroy(); marks[p] = nil end
                end
            end)
            task.wait(0.15)
        end
    end)

    -- ---------- เครื่องยนต์ออโต้ + ปุ่มชุบ 1 วิ ----------
    local AUTO = {carry = false, revive = false, safe = false, warp = true, back = false}
    local eng = {phase = "idle", target = nil, t = 0, safe = nil, warned = false}
    local CARRY_WORDS, REVIVE_WORDS = {"carry", "อุ้ม", "pick"}, {"revive", "ชุบ", "help", "assist", "rescue"}

    local function findPrompt(plr, words)
        local ch = plr.Character
        if not ch then return nil end
        for _, d in ipairs(ch:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local t = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
                for _, w in ipairs(words) do
                    if t:find(w, 1, true) then return d end
                end
            end
        end
        return nil
    end
    local function fire(p)
        -- ตั้งให้ไม่ต้องกดค้าง (ชุบไว)
        pcall(function() p.HoldDuration = 0; p.RequiresLineOfSight = false end)
        if fireproximityprompt then
            pcall(fireproximityprompt, p)
            return true
        end
        if not eng.warned then eng.warned = true; notify("NEXORA", L("nofire"), 5, true) end
        return false
    end

    -- ปุ่ม "ชุบ 1 วิ": วาร์ปไปหาเพื่อนที่ล้มใกล้สุด แล้วยิงปุ่มชุบซ้ำๆ ภายใน 1 วินาที
    local reviving = false
    local function revive1s()
        if reviving then return end
        local h, m = hum(), myRoot()
        if not h or not m or h.Health <= 0 then return end
        local e = nearestDowned()
        if not e then notify("NEXORA", L("nobody"), 2, true); return end
        reviving = true
        task.spawn(function()
            local origin = m.CFrame
            local found, ok = false, false
            pcall(function()
                local t0 = tick()
                repeat
                    if not e.plr.Parent or not isDowned(e.plr) then ok = true; break end
                    warpTo(e.root)
                    local p = findPrompt(e.plr, REVIVE_WORDS)
                    if p then found = true; fire(p) end
                    task.wait(0.1)
                until tick() - t0 >= 1
            end)
            if not ok and e.plr.Parent and not isDowned(e.plr) then ok = true end
            if AUTO.back then
                task.wait(0.35)
                pcall(function()
                    local mm = myRoot()
                    if mm then mm.CFrame = origin end
                end)
            end
            reviving = false
            if ok then
                notify(L("revived"), e.plr.DisplayName, 2, true)
            elseif not found then
                notify("NEXORA", L("noprompt"), 3, true)
            else
                notify("NEXORA", L("revtry") .. " " .. e.plr.DisplayName, 2, true)
            end
        end)
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(0.25)
            local on = AUTO.carry or AUTO.revive or AUTO.safe
            local h, m = hum(), myRoot()
            if not on or reviving or not h or not m or h.Health <= 0 then
                eng.phase = "idle"; eng.target = nil
            else
                pcall(function()
                    if eng.target and (not eng.target.plr.Parent or not isDowned(eng.target.plr)) then
                        eng.phase = "idle"; eng.target = nil
                    end
                    if eng.phase == "idle" then
                        local e = nearestDowned()
                        if e then eng.target = e; eng.phase = "go"; eng.t = tick() end
                    elseif eng.phase == "go" then
                        local r = eng.target.root
                        if not r.Parent then eng.phase = "idle"; return end
                        local d = (m.Position - r.Position).Magnitude
                        if d > 5 then
                            if AUTO.warp then
                                warpTo(r); d = 0
                            else
                                h:MoveTo(r.Position)
                            end
                        end
                        if d <= 5 then
                            if AUTO.safe or AUTO.carry then
                                local p = findPrompt(eng.target.plr, CARRY_WORDS)
                                if p then fire(p) end
                            end
                            if AUTO.safe then
                                local _, bp = nearestBot(m.Position)
                                local away = bp and (m.Position - bp) or Vector3.new(math.random() - .5, 0, math.random() - .5)
                                away = Vector3.new(away.X, 0, away.Z)
                                if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
                                eng.safe = m.Position + away.Unit * 80
                                eng.phase = "flee"; eng.t = tick()
                            else
                                if AUTO.revive then
                                    local p = findPrompt(eng.target.plr, REVIVE_WORDS)
                                    if p then fire(p) end
                                end
                                eng.phase = "cool"; eng.t = tick()
                            end
                        end
                        if tick() - eng.t > 20 then eng.phase = "idle" end
                    elseif eng.phase == "flee" then
                        h:MoveTo(eng.safe)
                        if (m.Position - eng.safe).Magnitude < 8 or tick() - eng.t > 8 then
                            if eng.target and eng.target.plr.Parent then
                                local p = findPrompt(eng.target.plr, REVIVE_WORDS)
                                if p then fire(p) end
                            end
                            eng.phase = "cool"; eng.t = tick()
                        end
                    elseif eng.phase == "cool" then
                        if tick() - eng.t > 2 then eng.phase = "idle" end
                    end
                end)
            end
        end
    end)

    -- ---------- 3) หมวดออโต้ ----------
    local autoP = AddTab(3, "🤖", "auto")
