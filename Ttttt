do
    local espP = AddTab(2, "🎯", "esp")
    local ESPF = {p_hl = false, p_name = false, p_dist = false, p_hp = false, d_hl = false,
                  b_hl = false, b_name = false, b_dist = false, range = 1500, brange = 1500, far = false}
    local colorsList = {
        Color3.fromRGB(255, 35, 55), Color3.fromRGB(60, 255, 120), Color3.fromRGB(70, 160, 255),
        Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 60),
    }
    local cIdx = {p = 1, b = 1}
    local DOWNED_COL = Color3.fromRGB(255, 170, 0)
    local espObjs = {}

    local note = new("TextLabel", {Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = SUB, Text = "ℹ️  " .. L("espnote"), Parent = espP})
    track(note, "espnote", "ℹ️  ")
    nonessential[#nonessential+1] = note

    -- ผู้เล่น
    Toggle(espP, "esp_p_hl", false, function(v) ESPF.p_hl = v end)
    Toggle(espP, "esp_p_name", false, function(v) ESPF.p_name = v end)
    Toggle(espP, "esp_p_dist", false, function(v) ESPF.p_dist = v end)
    Toggle(espP, "esp_p_hp", false, function(v) ESPF.p_hp = v end)
    Toggle(espP, "esp_d_hl", false, function(v) ESPF.d_hl = v end)
