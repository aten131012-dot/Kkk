local function new(c, p)
    local o = Instance.new(c)
    for k, v in pairs(p) do if k ~= "Parent" then o[k] = v end end
    if p.Parent then o.Parent = p.Parent end
    return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r), Parent = o}) end
local glows = {}
local function stroke(o, th, glow)
    local s = new("UIStroke", {Color = RED, Thickness = th or 1.5, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o})
    if glow then glows[#glows+1] = s end
    return s
end
local function tw(o, t, props, style, dir)
    local tween = TweenService:Create(o, TweenInfo.new(reduceAnim and 0.01 or t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

