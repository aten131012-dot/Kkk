            end
        else
            for o, en in pairs(lessSaved) do if o.Parent then o.Enabled = en end end
            lessSaved = {}
        end
    end
    local function applySaver(v)
        saverOn = v
        if v then
            pcall(function() saverState.q = settings().Rendering.QualityLevel; settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
            saverState.shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
            pcall(function() if setfpscap then setfpscap(30) end end)
            saverFx = {}
