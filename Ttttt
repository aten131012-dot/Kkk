local function L(k) return T[lang][k] or k end
local reg, langListeners = {}, {}
local function track(o, k, prefix) reg[#reg+1] = {o, k, prefix or ""} end
local function setLang(l)
    lang = l
    for _, r in ipairs(reg) do
        if r[1] and r[1].Parent then r[1].Text = r[3] .. L(r[2]) end
    end
    for _, f in ipairs(langListeners) do pcall(f) end
end

