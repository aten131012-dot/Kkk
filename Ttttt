    Slider(espP, "espbrange", 100, 5000, 1500, function(v) ESPF.brange = v end)
    Toggle(espP, "espfar", false, function(v) ESPF.far = v end)

    local function ColorBtn(key, field)
        cIdx[field] = 1
        local sw
        local b = Styled(espP, 54, function()
            cIdx[field] = cIdx[field] % #colorsList + 1
            sw.BackgroundColor3 = colorsList[cIdx[field]]
        end)
        local l = new("TextLabel", {Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(28, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, Text = "🎨  " .. L(key), Parent = b})
        track(l, key, "🎨  ")
        sw = new("Frame", {Size = UDim2.fromOffset(46, 28), Position = UDim2.new(1, -64, .5, -14), BackgroundColor3 = colorsList[1], Parent = b})
        corner(sw, 8)
    end
    ColorBtn("espcolorp", "p")
    ColorBtn("espcolorb", "b")

    local function clear(key)
        local o = espObjs[key]
        if o then
            if o.hl then o.hl:Destroy() end
            if o.bb then o.bb:Destroy() end
            espObjs[key] = nil
        end
    end
    local function ensure(key, adornee, root, needHL, needBB)
        local o = espObjs[key]
        if o and o.adornee ~= adornee then clear(key); o = nil end
        if not o then o = {adornee = adornee}; espObjs[key] = o end
        if needHL then
            if not o.hl or not o.hl.Parent then
                o.hl = new("Highlight", {Adornee = adornee, FillTransparency = .55, OutlineColor = Color3.new(1, 1, 1), OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = gui})
            end
        elseif o.hl then o.hl:Destroy(); o.hl = nil end
        if needBB then
            if not o.bb or not o.bb.Parent then
                o.bb = new("BillboardGui", {Adornee = root, AlwaysOnTop = true, Size = UDim2.fromOffset(260, 50), StudsOffset = Vector3.new(0, 3.4, 0), ResetOnSpawn = false, Parent = gui})
                o.tl = new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = TEXT, TextStrokeTransparency = .3, TextStrokeColor3 = Color3.new(0, 0, 0), Text = "", Parent = o.bb})
            end
            o.bb.Adornee = root
        elseif o.bb then o.bb:Destroy(); o.bb = nil; o.tl = nil end
        return o
    end

    local function step()
        local m = myRoot()
        local seen, hlCount = {}, 0
        -- ผู้เล่น
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local ch = p.Character
                local r = ch and ch:FindFirstChild("HumanoidRootPart")
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local d = m and (m.Position - r.Position).Magnitude or 0
                    if d <= ESPF.range then
                        local dn = isDowned(p)
                        local needHL = (ESPF.p_hl or (dn and ESPF.d_hl)) and hlCount < 30
                        local needBB = ESPF.p_name or ESPF.p_dist or ESPF.p_hp
                        if needHL or needBB then
                            local o = ensure(p, ch, r, needHL, needBB)
                            seen[p] = true
                            local col = colorsList[cIdx.p]
                            if needHL then
                                hlCount += 1
                                o.hl.FillColor = (dn and ESPF.d_hl) and DOWNED_COL or col
                            end
                            if needBB then
                                local parts = {}
                                if ESPF.p_name then parts[#parts+1] = p.DisplayName end
                                if ESPF.p_dist and m then parts[#parts+1] = math.floor(d) .. " m" end
                                if ESPF.p_hp then parts[#parts+1] = "❤ " .. math.floor(h.Health) end
                                o.tl.TextColor3 = col
                                o.tl.Text = table.concat(parts, "  |  ")
                            end
                        end
                    end
                end
            end
        end
        -- โรบอท
        if ESPF.b_hl or ESPF.b_name or ESPF.b_dist then
            local brange = ESPF.far and 5000 or ESPF.brange
            local list = {}
            for mdl, r in pairs(bots) do
                if mdl.Parent and r.Parent and not Players:GetPlayerFromCharacter(mdl) then
                    local d = m and (m.Position - r.Position).Magnitude or 0
                    if d <= brange then list[#list+1] = {mdl = mdl, r = r, d = d} end
                else
                    bots[mdl] = nil
                end
            end
            if ESPF.far then table.sort(list, function(a, b) return a.d < b.d end) end
            for i, e in ipairs(list) do
                if ESPF.far and i > 40 then break end
                local needHL = ESPF.b_hl and hlCount < 30 and (not ESPF.far or i <= 6)
                local needBB = ESPF.b_name or ESPF.b_dist
                if needHL or needBB then
                    local o = ensure(e.mdl, e.mdl, e.r, needHL, needBB)
                    seen[e.mdl] = true
                    local col = colorsList[cIdx.b]
                    if needHL then hlCount += 1; o.hl.FillColor = col end
                    if needBB then
                        local parts = {}
                        if ESPF.b_name then parts[#parts+1] = e.mdl.Name end
                        if ESPF.b_dist and m then parts[#parts+1] = math.floor(e.d) .. " m" end
                        o.tl.TextColor3 = col
                        o.tl.Text = table.concat(parts, "  |  ")
                    end
                end
            end
        end
        for k in pairs(espObjs) do
            if not seen[k] then clear(k) end
        end
    end
    connect(Players.PlayerRemoving, clear)
    task.spawn(function()
        while gui.Parent do
            pcall(step)
            task.wait(ESPF.far and 0.3 or 0.1)
        end
    end)
