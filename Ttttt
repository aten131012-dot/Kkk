                    if o.Enabled then o.Enabled = false; saverFx[#saverFx+1] = o end
                end
            end
        else
            pcall(function() if saverState.q then settings().Rendering.QualityLevel = saverState.q end end)
            if saverState.shadows ~= nil then Lighting.GlobalShadows = saverState.shadows end
            pcall(function() if setfpscap then setfpscap(0) end end)
            for _, o in ipairs(saverFx) do if o.Parent then o.Enabled = true end end
            saverFx = {}
        end
    end
    local function applyUltra(v)
        ultraOn = v
        if v then
            pcall(function() saverState.uq = settings().Rendering.QualityLevel; settings().Rendering.QualityLevel = Enum.QualityLevel.Level21 end)
            new("BloomEffect", {Name = "NEXORA_FX", Intensity = .6, Size = 30, Threshold = .9, Parent = Lighting})
            new("ColorCorrectionEffect", {Name = "NEXORA_FX", Saturation = .25, Contrast = .15, Parent = Lighting})
            new("SunRaysEffect", {Name = "NEXORA_FX", Intensity = .15, Spread = .8, Parent = Lighting})
        else
            pcall(function() if saverState.uq then settings().Rendering.QualityLevel = saverState.uq end end)
            for _, o in ipairs(Lighting:GetChildren()) do if o.Name == "NEXORA_FX" then o:Destroy() end end
        end
    end
    restorers[#restorers+1] = function()
