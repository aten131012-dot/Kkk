local function CatLogo(parent, size, pos, anchor)
    local f = new("Frame", {Size = UDim2.fromOffset(size, size), Position = pos or UDim2.new(), AnchorPoint = anchor or Vector2.new(), BackgroundTransparency = 1, Parent = parent})
    local earL = new("Frame", {Size = UDim2.fromScale(.3, .3), Position = UDim2.fromScale(.12, .08), Rotation = 45, BackgroundColor3 = RED, Parent = f})
    local earR = new("Frame", {Size = UDim2.fromScale(.3, .3), Position = UDim2.fromScale(.58, .08), Rotation = 45, BackgroundColor3 = RED, Parent = f})
    corner(earL, size * 0.05); corner(earR, size * 0.05)
    local head = new("Frame", {Size = UDim2.fromScale(.8, .66), Position = UDim2.fromScale(.1, .26), BackgroundColor3 = Color3.fromRGB(18, 18, 22), Parent = f})
    corner(head, size * 0.28); stroke(head, math.max(1.5, size / 28), true)
    local eyeL = new("Frame", {Size = UDim2.fromScale(.15, .2), Position = UDim2.fromScale(.26, .45), BackgroundColor3 = RED, Parent = f})
    local eyeR = new("Frame", {Size = UDim2.fromScale(.15, .2), Position = UDim2.fromScale(.59, .45), BackgroundColor3 = RED, Parent = f})
    corner(eyeL, 999); corner(eyeR, 999)
    local nose = new("Frame", {Size = UDim2.fromScale(.08, .06), Position = UDim2.fromScale(.46, .68), BackgroundColor3 = Color3.fromRGB(255, 120, 130), Parent = f})
    corner(nose, 999)
    for i = -1, 1, 2 do
        for j = 0, 1 do
            new("Frame", {Size = UDim2.fromScale(.2, .012), Position = UDim2.fromScale(i == -1 and .06 or .74, .7 + j * .06), Rotation = i * (j == 0 and 8 or -8), BackgroundColor3 = SUB, BorderSizePixel = 0, Parent = f})
        end
    end
    task.spawn(function()
        local t = 0
        while f.Parent do
            t += 1
            tw(earL, .15, {Rotation = 38}); tw(earR, .15, {Rotation = 52})
            task.wait(.18)
            tw(earL, .15, {Rotation = 45}); tw(earR, .15, {Rotation = 45})
            task.wait(1.2)
            if t % 2 == 0 then
                tw(eyeL, .08, {Size = UDim2.fromScale(.15, .02), Position = UDim2.fromScale(.26, .54)})
                tw(eyeR, .08, {Size = UDim2.fromScale(.15, .02), Position = UDim2.fromScale(.59, .54)})
                task.wait(.12)
                tw(eyeL, .08, {Size = UDim2.fromScale(.15, .2), Position = UDim2.fromScale(.26, .45)})
                tw(eyeR, .08, {Size = UDim2.fromScale(.15, .2), Position = UDim2.fromScale(.59, .45)})
            end
            task.wait(1.4)
        end
    end)
    return f
end

