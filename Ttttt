    Toggle(autoP, "alert", false, function(v) FLAGS.alert = v end)
    local _, rs1 = Toggle(autoP, "radarfriends", false, function(v) setRadarAll(v) end)
    radarSetters[#radarSetters+1] = rs1

    -- รายชื่อเพื่อนที่ควรไปช่วย (เรียงตามความเหมาะสม)
    local prioBox = new("Frame", {Size = UDim2.new(1, -6, 0, 170), BackgroundColor3 = Color3.new(1, 1, 1), Parent = autoP})
    corner(prioBox, 12); stroke(prioBox, 1.6, true)
    new("UIGradient", {Color = GRAD_IDLE, Parent = prioBox})
    local prioT = new("TextLabel", {Size = UDim2.new(1, -30, 0, 28), Position = UDim2.fromOffset(18, 6), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 17, TextColor3 = RED, TextXAlignment = Enum.TextXAlignment.Left, Text = "", Parent = prioBox})
    track(prioT, "prio", "📋  ")
    local prioL = new("TextLabel", {Size = UDim2.new(1, -30, 1, -40), Position = UDim2.fromOffset(18, 36), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 16, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = prioBox})
    Live(function()
        prioT.Text = "📋  " .. L("prio")
        if #WS.downed == 0 then prioL.Text = L("nobody"); return end
        local lines = {}
        for i = 1, math.min(5, #WS.downed) do
            local e = WS.downed[i]
            lines[#lines+1] = i .. ". " .. e.plr.DisplayName .. "  —  " .. math.floor(e.dist) .. " m"
        end
        prioL.Text = table.concat(lines, "\n")
    end)

    StatRow(autoP, "alive", function() return WS.alive end)
    StatRow(autoP, "teamstat", function() return "✅ " .. WS.alive .. "   ⚠ " .. WS.dn end)
    StatRow(autoP, "nearest", function()
